@TodoMultipleDbContext_HostAddress = http://localhost:5197

### OpenAPI document
GET {{TodoMultipleDbContext_HostAddress}}/openapi/v1.json
Accept: application/json

###

### Get all to-do items
GET {{TodoMultipleDbContext_HostAddress}}/todos
Accept: application/json

###

### Create a to-do item
POST {{TodoMultipleDbContext_HostAddress}}/todos
Content-Type: application/json

{
  "title": "Plan trip",
  "description": "Book flights and pack"
}

###

### Get a to-do item by id
GET {{TodoMultipleDbContext_HostAddress}}/todos/1
Accept: application/json

###

### Get a non-existent to-do item (expect 404)
GET {{TodoMultipleDbContext_HostAddress}}/todos/9999
Accept: application/json

###

### Update a to-do item (status is derived from sub-items, not settable here)
PUT {{TodoMultipleDbContext_HostAddress}}/todos/1
Content-Type: application/json

{
  "title": "Plan trip",
  "description": "Book flights and pack"
}

###

### Delete a to-do item (cascades to its sub-items)
DELETE {{TodoMultipleDbContext_HostAddress}}/todos/1

###

### Get all sub-items for a to-do
GET {{TodoMultipleDbContext_HostAddress}}/todos/1/subtodos
Accept: application/json

###

### Create a sub-item (defaults to NotStarted)
POST {{TodoMultipleDbContext_HostAddress}}/todos/1/subtodos
Content-Type: application/json

{
  "title": "Book flights"
}

###

### Create a sub-item with an explicit status
POST {{TodoMultipleDbContext_HostAddress}}/todos/1/subtodos
Content-Type: application/json

{
  "title": "Pack bags",
  "status": "InProgress"
}

###

### Get a sub-item by id
GET {{TodoMultipleDbContext_HostAddress}}/todos/1/subtodos/1
Accept: application/json

###

### Create a sub-item under a non-existent to-do (expect 404)
POST {{TodoMultipleDbContext_HostAddress}}/todos/9999/subtodos
Content-Type: application/json

{
  "title": "Orphan"
}

###

### Update a sub-item
PUT {{TodoMultipleDbContext_HostAddress}}/todos/1/subtodos/1
Content-Type: application/json

{
  "title": "Book flights",
  "status": "Completed"
}

###

### Delete a sub-item
DELETE {{TodoMultipleDbContext_HostAddress}}/todos/1/subtodos/1

###
